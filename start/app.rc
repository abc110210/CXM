// DiskStressStart.exe version resource (pure ASCII to avoid codepage issues)
// Signed-free exes without VERSIONINFO are prime heuristic-detection targets;
// adding proper metadata reduces antivirus false positives.

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "DiskStress Project"
            VALUE "FileDescription",  "DiskStress 4KiB Random Write Stress Worker"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "DiskStressStart"
            VALUE "LegalCopyright",   "Freeware. For disk performance testing only."
            VALUE "OriginalFilename", "DiskStressStart.exe"
            VALUE "ProductName",      "DiskStress"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
